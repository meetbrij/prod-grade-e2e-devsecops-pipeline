# Prometheus, Alertmanager, Grafana, node and kube-state exporters.
fullnameOverride: kube-prometheus-stack

# EKS runs the control plane, so these components cannot be scraped and would only raise
# false "target down" alerts.
kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false

defaultRules:
  rules:
    etcd: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    kubeProxy: false

prometheus:
  prometheusSpec:
    retention: ${metrics_retention}
    # Pick up ServiceMonitors/PodMonitors from any namespace (app metrics later).
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    resources:
      requests:
        cpu: 200m
        memory: 1Gi
      limits:
        memory: 2Gi
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: ${prometheus_storage_size}

alertmanager:
  alertmanagerSpec:
    resources:
      requests:
        cpu: 20m
        memory: 64Mi

prometheusOperator:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi

nodeExporter:
  resources:
    requests:
      cpu: 20m
      memory: 32Mi

kube-state-metrics:
  resources:
    requests:
      cpu: 20m
      memory: 64Mi

grafana:
  # No adminPassword is set on purpose: the chart generates a random one and keeps it
  # across upgrades. Read it with:
  #   kubectl get secret kube-prometheus-stack-grafana -n ${namespace} -o jsonpath='{.data.admin-password}' | base64 -d
  # Grafana is only reachable through `kubectl port-forward` (ClusterIP service, no Ingress).
  service:
    type: ClusterIP
  resources:
    requests:
      cpu: 50m
      memory: 192Mi
  additionalDataSources:
    - name: Loki
      type: loki
      uid: loki
      access: proxy
      url: ${loki_url}
      jsonData:
        maxLines: 1000
    - name: Tempo
      type: tempo
      uid: tempo
      access: proxy
      url: ${tempo_url}
