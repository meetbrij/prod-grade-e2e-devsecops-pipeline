# Keep the build context to what the image needs: the Dockerfile copies app/requirements.txt
# and app/kyc only.

# Git and CI
.git
.gitignore
.github

# Documentation
**/*.md

# Local environment files and secrets
.env
.env.*
*.env

# Python
.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache

# Not part of the image
terraform
k8-manifests
project-docs
app/tests
app/eval
sonar-project.properties

# Terraform state
*.tfstate
*.tfstate.*
.terraform

# Editors, OS and logs
.vscode
.idea
*.swp
.DS_Store
*.log
tmp/
